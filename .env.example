# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Supabase PostgreSQL Database & API
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session Authentication
JWT_SECRET=

# Public site
# Canonical origin, no trailing slash (e.g. https://heyitsme.fyi). Used for canonical
# links, sitemap, robots, and absolute Open Graph image URLs at build time.
SITE_URL=https://heyitsme.fyi
# Shown on /privacy and /terms as the contact address.
VITE_SUPPORT_EMAIL=

# Shared rate limits (optional). Without these each server instance counts on its own.
# The Vercel Upstash/KV integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upload storage. Supabase Storage is used when S3_BUCKET is empty; it needs SUPABASE_URL
# and SUPABASE_SERVICE_ROLE_KEY (the Vercel Supabase integration's names also work). Bucket is created on first upload.
SUPABASE_STORAGE_BUCKET=uploads
# Or Amazon S3:
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
